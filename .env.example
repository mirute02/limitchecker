# 実値は .env に書く（.env は gitignore 済み。このファイルは雛形）

# hub の認証トークン。必ず自分で生成する。既定値は存在せず、未設定なら hub は起動しない。
#   生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LIMITCHECKER_TOKEN=

# hub の待ち受けアドレス。「自分のどの口で待つか」なので、
# この機械に実在するアドレスを書く。0.0.0.0 は拒否される。
#
#   127.0.0.1  … この機械の中からのみ（既定）
#   tailscale  … Tailscale のアドレスを自動で引く（外出先から見る場合はこれ）
#   100.x.y.z  … 直接書いてもよい
#
# 注意: アプリに入れる URL はこれとは別。Android は平文 HTTP を
# 名前で照合するため、IP ではなく MagicDNS 名を使う。
# 正しい URL は ./deploy/install-hub.sh が最後に表示する。
LIMITCHECKER_BIND=127.0.0.1
LIMITCHECKER_PORT=8787

# このマシンの短いラベル。ホスト名は自動取得しない（環境名の露出を避けるため）。
LIMITCHECKER_MACHINE_ID=mac
LIMITCHECKER_MACHINE_LABEL=Mac

# このマシンが使っているアカウントのラベル。
# 同じラベルのマシン同士を「同一アカウント」として残量を1組に畳む。
# 認証情報やメールアドレスは使わない。任意の短い文字列でよい。
LIMITCHECKER_CLAUDE_ACCOUNT=personal
LIMITCHECKER_CODEX_ACCOUNT=personal

# Codex の実行ファイル。通常は不要（PATH の codex を使う）。
# Termux のように通信へ回避策が要る環境では、そのラッパーを指定する。
# alias はスクリプト内で展開されないため、ここで明示する必要がある。
#LIMITCHECKER_CODEX_BIN=/path/to/codex-wrapper

# 作業ディレクトリの送信方法: none（送らない） | basename（末尾のみ）
# フルパスを送る選択肢は用意しない。
LIMITCHECKER_CWD_REPORT=basename
