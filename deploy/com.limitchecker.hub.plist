<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS で hub を常駐させる launchd 設定。

    sed 's|__HOME__|'"$HOME"'|g' deploy/com.limitchecker.hub.plist \
      > ~/Library/LaunchAgents/com.limitchecker.hub.plist
    launchctl load ~/Library/LaunchAgents/com.limitchecker.hub.plist

  停止: launchctl unload ~/Library/LaunchAgents/com.limitchecker.hub.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.limitchecker.hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/src/limitchecker/hub/server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/src/limitchecker</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
