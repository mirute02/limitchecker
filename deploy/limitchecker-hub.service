# Linux（GPU 機など）で hub を常駐させる systemd ユーザサービス。
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/limitchecker-hub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now limitchecker-hub
#   loginctl enable-linger $USER      # ログアウト後も動かす
#
# 状態確認: systemctl --user status limitchecker-hub
# ログ:     journalctl --user -u limitchecker-hub -f

[Unit]
Description=limitchecker hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/limitchecker
ExecStart=/usr/bin/python3 %h/src/limitchecker/hub/server.py
Restart=on-failure
RestartSec=5

# 必要以上の権限を持たせない
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 書き込むのは自分の状態ディレクトリだけ
ReadWritePaths=%h/.local/state/limitchecker

[Install]
WantedBy=default.target
