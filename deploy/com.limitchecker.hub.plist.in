<?xml version="1.0" encoding="UTF-8"?>
<!-- install-hub.sh が __REPO__ と __PYTHON__ を置換して
     ~/Library/LaunchAgents/ に書き出す。手で置く必要はない。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.limitchecker.hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/hub/server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- launchd の PATH は最小限で、tailscale が入っていない。
         LIMITCHECKER_BIND=tailscale のとき解決できず再起動ループになるため補う。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/Applications/Tailscale.app/Contents/MacOS:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
