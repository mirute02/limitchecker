#!/bin/sh
# 秘密・個人情報の混入をコミット前に止める。
#
# 有効化: git config core.hooksPath .githooks
# 緊急回避: LIMITCHECKER_SKIP_SCAN=1 git commit ...
#
# 移植性の注意（実際に踏んだもの）:
#   - shebang は #!/bin/sh。Termux 固有のパスを書くと Mac/Linux で起動しない。
#     #!/usr/bin/env bash は逆に Termux で動かない。
#   - 正規表現に \s \b \d (?!) を使わない。POSIX 拡張正規表現の規格外で、
#     環境によって黙ってマッチしなくなる。POSIX 文字クラスを使う。
#   - bash 固有の ${var:0:n} も使わない。

set -u

[ "${LIMITCHECKER_SKIP_SCAN:-0}" = "1" ] && exit 0

fail=0
note() { printf '  %s\n' "$1"; }

# --- 1. 入れてはいけないファイル ---
blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E \
  '(^|/)\.env$|(^|/)\.env\.[^/]*$|\.jks$|\.keystore$|google-services\.json$|(^|/)local\.properties$|(^|/)secrets/' \
  | grep -v '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "NG: コミットしてはいけないファイルが含まれています"
  note "$blocked"
  fail=1
fi

# --- 2. 内容スキャン（追加行のみ） ---
added=$(git diff --cached --diff-filter=ACM -U0 | grep '^+' | grep -v '^+++')
if [ -z "$added" ]; then
  [ $fail -eq 0 ] && exit 0 || exit 1
fi

scan() { # scan <label> <regex>
  hits=$(printf '%s\n' "$added" | grep -nEi "$2" | head -5)
  if [ -n "$hits" ]; then
    echo "NG: $1"
    printf '%s\n' "$hits" | cut -c1-120 | while IFS= read -r l; do note "$l"; done
    fail=1
  fi
}

scan "トークンらしき文字列" 'gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|AIza[A-Za-z0-9_-]{20,}|authorization:[[:space:]]*bearer[[:space:]]+[A-Za-z0-9._-]{16,}'
scan "端末の絶対パス"     '/data/data/com\.termux/files/home|/Users/[a-z0-9._-]+|/home/[a-z0-9._-]+/'
# \b は POSIX 規格外。前後を文字クラスで挟んで同じ意味にする。
scan "Tailscale アドレス" '(^|[^0-9.])100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)'

# メールは拾ってから許可ドメインを除く（ERE に否定先読みがないため）
mail_hits=$(printf '%s\n' "$added" \
  | grep -nEio '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
  | grep -viE '@(users\.noreply\.github\.com|example\.(com|org|net)|anthropic\.com)$' | head -5)
if [ -n "$mail_hits" ]; then
  echo "NG: メールアドレス"
  printf '%s\n' "$mail_hits" | while IFS= read -r l; do note "$l"; done
  fail=1
fi

if [ $fail -ne 0 ]; then
  echo
  echo "意図的な場合のみ: LIMITCHECKER_SKIP_SCAN=1 git commit ..."
  exit 1
fi
exit 0
